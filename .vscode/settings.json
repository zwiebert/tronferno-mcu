{
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "editor.codeActionsOnSave": [],
  "files.associations": {
    "CMakeLists.txt": "cmake",
    "regex": "cpp",
    "*.ipp": "cpp"
  },
  "clang-tidy.buildPath": "build/host-test",
  "window.title": "TronfernoMCU${separator}${activeEditorLong}",
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${sourceDirectory}/build",
  "cmake.configureArgs": [
    "-DBUILD_HOST_TESTS=ON"
  ],
  "cmake.sourceDirectory": "${workspaceFolder}",
  "output.smartScroll.enabled": false,
  "stm32-for-vscode.openOCDPath": false,
  "C_Cpp.errorSquiggles": "enabled",
  "idf.buildPath": "${workspaceFolder}/configs/esp-idf/esp32-debug/build",
  "idf.sdkconfigFilePath": "${workspaceFolder}/configs/esp-idf/esp32-debug/sdkconfig",
  "idf.sdkconfigDefaults": ["${workspaceFolder}/configs/esp-idf/esp32-debug/sdkconfig.defaults"],
  "idf.port": "/dev/ttyUSB1",
  "idf.flashType": "UART",
  "idf.currentSetup": "/home/bertw/.espressif/v5.5.3/esp-idf",
  "idf.monitorPort": "/dev/ttyUSB1",
  "idf.openOcdConfigs": [
    "/home/bertw/esp/ft2232.cfg",
    "target/esp32.cfg"
  ]
}
