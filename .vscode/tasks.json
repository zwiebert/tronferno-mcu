{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "build app",
            "type": "shell",
            "command": [
                ". $HOME/esp/esp-idf/export.sh && ",
                "idf.py --preset=esp32-debug build"
            ],
            "args": [],
            "presentation": {
                "reveal": "always",
                "echo": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "clean app",
            "type": "shell",
            "command": [
                ". $HOME/esp/esp-idf/export.sh && ",
                "idf.py --preset=esp32-debug fullclean"
            ],
            "args": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "menuconfig",
            "command": "make",
            "type": "shell",
            "args": [
                "flavor=esp32-debug",
                "esp32-menuconfig"
            ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}